# Google Search Console → Settings → Ownership verification → "HTML tag".
# Paste only the content value, e.g. for <meta name="google-site-verification" content="abc123" /> use abc123.
# Copy this file to .env.local (or set it in your host's environment variables) and rebuild.
# Not needed if cosmonus.com is verified with a DNS record.
GOOGLE_SITE_VERIFICATION=
